class PricingTable:
    def __init__(self) -> None:
        self._prices: dict[str, Pricing] = dict(EMBEDDED_PRICING)
        self._source = "embedded"

    def load_litellm(self, timeout: float = 15.0) -> bool:
        try:
            with urllib.request.urlopen(LITELLM_URL, timeout=timeout) as resp:
                data = json.loads(resp.read())
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError) as e:
            print(f"warning: could not fetch live pricing ({e}); using embedded", file=sys.stderr)
            return False

        loaded = 0
        for key, info in data.items():
            if not isinstance(info, dict):
                continue
            if "/" in key or key.startswith(("azure", "bedrock", "vertex", "anthropic.")):
                continue
            inp = info.get("input_cost_per_token")
            out = info.get("output_cost_per_token")
            if inp is None or out is None:
                continue
            self._prices[key] = Pricing(
                input=float(inp),
                output=float(out),
                cache_create=float(info.get("cache_creation_input_token_cost") or 0.0),
                cache_read=float(info.get("cache_read_input_token_cost") or 0.0),
            )
            loaded += 1
        self._source = f"litellm ({loaded} models)"
        return True

    @property
    def source(self) -> str:
        return self._source

    def resolve(self, model: str) -> str | None:
        """Return the canonical pricing key for a model name, or None."""
        if not model:
            return None
        name = model.strip()
        if name in self._prices:
            return name
        if name in MODEL_ALIASES:
            alias = MODEL_ALIASES[name]
            if alias in self._prices:
                return alias
        # Strip thinking / speed suffixes
        cleaned = re.sub(r"-(thinking|high-thinking|fast)$", "", name)
        if cleaned in self._prices:
            return cleaned
        if cleaned in MODEL_ALIASES and MODEL_ALIASES[cleaned] in self._prices:
            return MODEL_ALIASES[cleaned]
        # Fuzzy: find a pricing key that the model name contains, or vice versa
        lower = name.lower()
        candidates = [k for k in self._prices if k in lower or lower in k]
        if candidates:
            # Prefer longest match
            return max(candidates, key=len)
        return None

    def find(self, model: str) -> Pricing | None:
        key = self.resolve(model)
        return self._prices.get(key) if key else None

    def cost_for(self, entry: UsageEntry) -> float | None:
        pricing = self.find(entry.model)
        if pricing is None:
            return None
        return (
            entry.input_tokens * pricing.input
            + entry.output_tokens * pricing.output
            + entry.cache_create_tokens * (pricing.cache_create or pricing.input * 1.25)
            + entry.cache_read_tokens * (pricing.cache_read or pricing.input * 0.1)
        )


# ── Helpers ───────────────────────────────────────────────────────────────────

_HOME = str(Path.home())


def shorten_home(path: str) -> str:
    if path.startswith(_HOME):
        return "~" + path[len(_HOME) :]
    return path


def uri_to_path(uri: str) -> str:
    if uri.startswith("file://"):
        return unquote(urlparse(uri).path)
    return uri


def epoch_ms_to_date(ms: int | float) -> str:
    return (
        datetime.fromtimestamp(ms / 1000, tz=timezone.utc)
        .astimezone()
        .strftime("%Y-%m-%d")
    )


def iso_to_date(ts: str) -> str:
    if not ts:
        return "unknown"
    try:
        # Handle both Z and offsets
        cleaned = ts.replace("Z", "+00:00")
        return datetime.fromisoformat(cleaned).astimezone().strftime("%Y-%m-%d")
    except ValueError:
        return ts[:10] if len(ts) >= 10 else "unknown"


def fmt_tokens(n: int) -> str:
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    return str(n)


def fmt_cost(n: float) -> str:
    if n >= 100:
        return f"${n:.2f}"
    if n >= 1:
        return f"${n:.3f}"
    if n > 0:
        return f"${n:.4f}"
    return "$0.00"


# ── Backends ──────────────────────────────────────────────────────────────────


class UsageBackend(abc.ABC):
    name: str

    @abc.abstractmethod
    def is_available(self) -> bool: ...

    @abc.abstractmethod
    def load_entries(
        self,
        *,
        workspace: str | None = None,
        default_model: str | None = None,
    ) -> list[UsageEntry]: ...


class CursorBackend(UsageBackend):
    name = "cursor"

    DB_PATH = Path.home() / "Library/Application Support/Cursor/User/globalStorage/state.vscdb"
    WS_STORAGE = Path.home() / "Library/Application Support/Cursor/User/workspaceStorage"

    def is_available(self) -> bool:
        return self.DB_PATH.exists()

    def _connect(self) -> sqlite3.Connection:
        conn = sqlite3.connect(f"file:{self.DB_PATH}?mode=ro", uri=True)
        conn.row_factory = sqlite3.Row
        return conn

    def _workspace_map(self) -> dict[str, list[str]]:
        """workspace_path → [composer_ids]"""
        ws_map: dict[str, list[str]] = {}
        for ws_dir in globmod.glob(str(self.WS_STORAGE / "*")):
            ws_json = Path(ws_dir) / "workspace.json"
            state_db = Path(ws_dir) / "state.vscdb"
            if not ws_json.exists() or not state_db.exists():
                continue
            try:
                ws_data = json.loads(ws_json.read_text())
            except (json.JSONDecodeError, OSError):
                continue
            folder_uri = ws_data.get("folder", "")
            if not folder_uri:
                continue
            folder_path = uri_to_path(folder_uri)
            try:
                conn = sqlite3.connect(f"file:{state_db}?mode=ro", uri=True)
                row = conn.execute(
                    "SELECT value FROM ItemTable WHERE key = 'composer.composerData'"
                ).fetchone()
                ids: list[str] = []
                if row and row[0]:
                    ids = json.loads(row[0]).get("selectedComposerIds", [])
                conn.close()
            except Exception:
                continue
            if ids:
                ws_map[folder_path] = ids
        return ws_map

    def _resolve_workspace(self, query: str, ws_map: dict[str, list[str]]) -> str | None:
        query = str(Path(query).expanduser().resolve())
        if query in ws_map:
            return query
        for p in ws_map:
            if p.endswith(query) or query.endswith(p.rsplit("/", 1)[-1]):
                return p
        for p in ws_map:
            if query in p or p in query:
                return p
        return None

    def load_entries(
        self,
        *,
        workspace: str | None = None,
        default_model: str | None = None,
    ) -> list[UsageEntry]:
        conn = self._connect()
        ws_map = self._workspace_map()
        id_to_ws: dict[str, str] = {}
        for path, ids in ws_map.items():
            for cid in ids:
                id_to_ws[cid] = path

        allowed_ids: set[str] | None = None
        if workspace:
            resolved = self._resolve_workspace(workspace, ws_map)
            if not resolved:
                conn.close()
                return []
            allowed_ids = set(ws_map[resolved])

        # composer_id → metadata
        # Newer Cursor versions often leave bubble tokenCount at 0 and only
        # store a context-window snapshot on the composer (contextTokensUsed).
        composer_meta: dict[str, dict] = {}
        for row in conn.execute(
            "SELECT key, value FROM cursorDiskKV WHERE key LIKE 'composerData:%' AND value IS NOT NULL"
        ):
            cid = row["key"].split(":", 1)[1]
            try:
                data = json.loads(row["value"])
            except json.JSONDecodeError:
                continue
            mc = data.get("modelConfig") or {}
            model = (mc.get("modelName") if isinstance(mc, dict) else None) or "unknown"
            if model == "default" and default_model:
                model = default_model
            created = data.get("createdAt") or data.get("lastUpdatedAt")
            date = epoch_ms_to_date(created) if created else "unknown"
            ctx = int(data.get("contextTokensUsed") or 0)
            ptb = data.get("promptTokenBreakdown") or {}
            if isinstance(ptb, dict) and ptb.get("totalUsedTokens"):
                ctx = max(ctx, int(ptb["totalUsedTokens"]))
            composer_meta[cid] = {
                "model": model,
                "date": date,
                "context_tokens": ctx,
            }

        entries: list[UsageEntry] = []
        composers_with_bubble_tokens: set[str] = set()

        for row in conn.execute(
            "SELECT key, value FROM cursorDiskKV WHERE key LIKE 'bubbleId:%' AND value IS NOT NULL"
        ):
            key = row["key"]
            # bubbleId:<composerId>:<bubbleId>
            parts = key.split(":", 2)
            if len(parts) < 3:
                continue
            cid = parts[1]
            if allowed_ids is not None and cid not in allowed_ids:
                continue
            try:
                bubble = json.loads(row["value"])
            except json.JSONDecodeError:
                continue
            tc = bubble.get("tokenCount") or {}
            inp = int(tc.get("inputTokens") or 0)
            out = int(tc.get("outputTokens") or 0)
            if inp == 0 and out == 0:
                continue

            meta = composer_meta.get(cid, {"model": "unknown", "date": "unknown"})
            created = bubble.get("createdAt")
            if created:
                date = created[:10] if isinstance(created, str) else epoch_ms_to_date(created)
            else:
                date = meta["date"]

            composers_with_bubble_tokens.add(cid)
            entries.append(
                UsageEntry(
                    source=self.name,
                    date=date,
                    model=meta["model"],
                    input_tokens=inp,
                    output_tokens=out,
                    cost_kind="estimated",  # Cursor is subscription; this is counterfactual
                    session_id=cid,
                    workspace=id_to_ws.get(cid, ""),
                )
            )

        # Fallback: composers with no per-bubble tokens but a context snapshot.
        # This undercounts (one snapshot ≠ cumulative billable tokens) but is
        # the only signal Cursor still writes for recent agent chats.
        for cid, meta in composer_meta.items():
            if allowed_ids is not None and cid not in allowed_ids:
                continue
            if cid in composers_with_bubble_tokens:
                continue
            ctx = meta["context_tokens"]
            if ctx <= 0:
                continue
            entries.append(
                UsageEntry(
                    source=self.name,
                    date=meta["date"],
                    model=meta["model"],
                    input_tokens=ctx,
                    output_tokens=0,
                    cost_kind="estimated",
                    session_id=cid,
                    workspace=id_to_ws.get(cid, ""),
                )
            )

        conn.close()
        return entries


class ClaudeCodeBackend(UsageBackend):
    name = "claude"

    PROJECT_DIRS = [
        Path.home() / ".claude" / "projects",
        Path.home() / ".config" / "claude" / "projects",
    ]

    def is_available(self) -> bool:
        return any(d.exists() and any(d.iterdir()) for d in self.PROJECT_DIRS if d.exists())

    def _decode_project_path(self, dirname: str) -> str:
        if not dirname.startswith("-"):
            return dirname
        return "/" + dirname[1:].replace("-", "/")

    def _session_files(self) -> list[tuple[Path, str]]:
        """Return (jsonl_path, workspace_path) pairs."""
        results: list[tuple[Path, str]] = []
        for base in self.PROJECT_DIRS:
            if not base.exists():
                continue
            for pdir in base.iterdir():
                if not pdir.is_dir():
                    continue
                ws = self._decode_project_path(pdir.name)
                # Sessions may live in sessions/ or directly in the project dir
                candidates = list((pdir / "sessions").glob("*.jsonl")) if (pdir / "sessions").exists() else []
                candidates.extend(pdir.glob("*.jsonl"))
                candidates.extend(pdir.glob("**/*.jsonl"))
                seen: set[Path] = set()
                for f in candidates:
                    if f in seen:
                        continue
                    seen.add(f)
                    results.append((f, ws))
        return results

    def load_entries(
        self,
        *,
        workspace: str | None = None,
        default_model: str | None = None,
    ) -> list[UsageEntry]:
        del default_model  # unused for Claude
        entries: list[UsageEntry] = []
        # Dedup by (message_id, request_id)
        seen: set[tuple[str, str]] = set()

        for path, ws in self._session_files():
            if workspace:
                query = str(Path(workspace).expanduser().resolve())
                if not (ws == query or ws.endswith(query) or query in ws or ws in query):
                    continue

            session_id = path.stem
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue

            for line in text.splitlines():
                if '"usage"' not in line:
                    continue
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue

                msg = obj.get("message") or {}
                usage = msg.get("usage") or obj.get("usage")
                if not isinstance(usage, dict):
                    continue

                model = msg.get("model") or obj.get("model") or "unknown"
                message_id = str(msg.get("id") or obj.get("uuid") or "")
                request_id = str(obj.get("requestId") or "")
                dedupe_key = (message_id, request_id)
                if message_id and dedupe_key in seen:
                    continue
                if message_id:
                    seen.add(dedupe_key)

                inp = int(usage.get("input_tokens") or 0)
                out = int(usage.get("output_tokens") or 0)
                cache_c = int(usage.get("cache_creation_input_tokens") or 0)
                cache_r = int(usage.get("cache_read_input_tokens") or 0)
                if inp + out + cache_c + cache_r == 0:
                    continue

                cost = obj.get("costUSD")
                cost_kind = "actual" if isinstance(cost, (int, float)) else "calculated"

                entries.append(
                    UsageEntry(
                        source=self.name,
                        date=iso_to_date(obj.get("timestamp", "")),
                        model=model,
                        input_tokens=inp,
                        output_tokens=out,
                        cache_create_tokens=cache_c,
                        cache_read_tokens=cache_r,
                        cost_usd=float(cost) if isinstance(cost, (int, float)) else None,
                        cost_kind=cost_kind,
                        session_id=obj.get("sessionId") or session_id,
                        workspace=ws,
                    )
                )
        return entries


