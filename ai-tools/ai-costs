ALL_BACKENDS: list[UsageBackend] = [
    CursorBackend(),
    ClaudeCodeBackend(),
    DevinBackend(),
]


def get_backends(source: str | None = None) -> list[UsageBackend]:
    if source:
        matches = [b for b in ALL_BACKENDS if b.name == source]
        if not matches:
            names = ", ".join(b.name for b in ALL_BACKENDS)
            print(f"Unknown source: {source} (available: {names})", file=sys.stderr)
            sys.exit(1)
        b = matches[0]
        if not b.is_available():
            print(f"{b.name} is not available on this machine.", file=sys.stderr)
            sys.exit(1)
        return matches

    available = [b for b in ALL_BACKENDS if b.is_available()]
    if not available:
        print("No AI usage data found on this machine.", file=sys.stderr)
        sys.exit(1)
    return available


# ── Aggregation ───────────────────────────────────────────────────────────────


def price_entries(entries: list[UsageEntry], pricing: PricingTable) -> list[UsageEntry]:
    for e in entries:
        if e.cost_usd is not None and e.cost_kind == "actual":
            continue
        cost = pricing.cost_for(e)
        if cost is None:
            e.cost_kind = "unknown"
            e.cost_usd = 0.0
        else:
            e.cost_usd = cost
            if e.source == "cursor":
                e.cost_kind = "estimated"
            elif e.cost_kind != "actual":
                e.cost_kind = "calculated"
    return entries


def filter_entries(
    entries: list[UsageEntry],
    *,
    since: str | None = None,
    until: str | None = None,
) -> list[UsageEntry]:
    out = []
    for e in entries:
        if e.date == "unknown":
            out.append(e)
            continue
        if since and e.date < since:
            continue
        if until and e.date > until:
            continue
        out.append(e)
    return out


def aggregate(
    entries: list[UsageEntry],
    *,
    group_by: str,  # "daily" | "monthly" | "session"
) -> list[PeriodSummary]:
    buckets: dict[tuple, PeriodSummary] = {}

    for e in entries:
        if group_by == "daily":
            period = e.date
            key = (period, e.source)
        elif group_by == "monthly":
            period = e.date[:7] if e.date != "unknown" else "unknown"
            key = (period, e.source)
        else:  # session
            period = e.date
            key = (e.session_id, e.source)

        if key not in buckets:
            buckets[key] = PeriodSummary(
                period=period if group_by != "session" else e.date,
                source=e.source,
                session_id=e.session_id if group_by == "session" else "",
                workspace=e.workspace if group_by == "session" else "",
            )
        s = buckets[key]
        s.input_tokens += e.input_tokens
        s.output_tokens += e.output_tokens
        s.cache_create_tokens += e.cache_create_tokens
        s.cache_read_tokens += e.cache_read_tokens
        s.cost_usd += e.cost_usd or 0.0
        s.cost_kinds.add(e.cost_kind)
        if group_by == "session" and not s.workspace:
            s.workspace = e.workspace

        mb = s.models.setdefault(
            e.model,
            {
                "input": 0,
                "output": 0,
                "cache_create": 0,
                "cache_read": 0,
                "cost": 0.0,
            },
        )
        mb["input"] += e.input_tokens
        mb["output"] += e.output_tokens
        mb["cache_create"] += e.cache_create_tokens
        mb["cache_read"] += e.cache_read_tokens
        mb["cost"] += e.cost_usd or 0.0

    return sorted(buckets.values(), key=lambda s: (s.period, s.source))


# ── Output ────────────────────────────────────────────────────────────────────


def cost_kind_label(kinds: set[str]) -> str:
    if not kinds or kinds <= {"actual", "calculated"}:
        return ""
    if kinds <= {"unknown"}:
        return "?"
    if "estimated" in kinds:
        return "~"
    if "unknown" in kinds:
        return "?"
    return ""


def print_table(
    summaries: list[PeriodSummary],
    *,
    group_by: str,
    breakdown: bool = False,
) -> None:
    if not summaries:
        print("No usage found.")
        return

    if group_by == "session":
        header = (
            f"{'Date':<12} {'Source':<8} {'Session':<14} {'Input':>8} {'Output':>8} "
            f"{'Cache+':>8} {'CacheR':>8} {'Cost':>10}  Models"
        )
    else:
        header = (
            f"{'Period':<12} {'Source':<8} {'Input':>8} {'Output':>8} "
            f"{'Cache+':>8} {'CacheR':>8} {'Cost':>10}  Models"
        )
    print(header)
    print("─" * len(header))

    totals = PeriodSummary(period="TOTAL", source="")
    all_kinds: set[str] = set()

    for s in summaries:
        models_str = ", ".join(sorted(s.models.keys())[:3])
        if len(s.models) > 3:
            models_str += f" (+{len(s.models) - 3})"
        prefix = cost_kind_label(s.cost_kinds)
        cost_str = prefix + fmt_cost(s.cost_usd)

        if group_by == "session":
            sid = s.session_id[:12]
            print(
                f"{s.period:<12} {s.source:<8} {sid:<14} "
                f"{fmt_tokens(s.input_tokens):>8} {fmt_tokens(s.output_tokens):>8} "
                f"{fmt_tokens(s.cache_create_tokens):>8} {fmt_tokens(s.cache_read_tokens):>8} "
                f"{cost_str:>10}  {models_str}"
            )
            if s.workspace:
                print(f"{'':12} {'':8} {shorten_home(s.workspace)}")
        else:
            print(
                f"{s.period:<12} {s.source:<8} "
                f"{fmt_tokens(s.input_tokens):>8} {fmt_tokens(s.output_tokens):>8} "
                f"{fmt_tokens(s.cache_create_tokens):>8} {fmt_tokens(s.cache_read_tokens):>8} "
                f"{cost_str:>10}  {models_str}"
            )

        if breakdown:
            for model, mb in sorted(s.models.items()):
                print(
                    f"{'':12} {'':8} "
                    f"{fmt_tokens(mb['input']):>8} {fmt_tokens(mb['output']):>8} "
                    f"{fmt_tokens(mb['cache_create']):>8} {fmt_tokens(mb['cache_read']):>8} "
                    f"{fmt_cost(mb['cost']):>10}  └ {model}"
                )

        totals.input_tokens += s.input_tokens
        totals.output_tokens += s.output_tokens
        totals.cache_create_tokens += s.cache_create_tokens
        totals.cache_read_tokens += s.cache_read_tokens
        totals.cost_usd += s.cost_usd
        all_kinds |= s.cost_kinds

    print("─" * len(header))
    prefix = cost_kind_label(all_kinds)
    print(
        f"{'TOTAL':<12} {'':8} "
        f"{fmt_tokens(totals.input_tokens):>8} {fmt_tokens(totals.output_tokens):>8} "
        f"{fmt_tokens(totals.cache_create_tokens):>8} {fmt_tokens(totals.cache_read_tokens):>8} "
        f"{(prefix + fmt_cost(totals.cost_usd)):>10}"
    )

    notes = []
    if "estimated" in all_kinds:
        notes.append("~ = estimated API cost (Cursor is subscription-based; counterfactual)")
        notes.append(
            "  Recent Cursor chats often lack per-message tokens; those rows use "
            "context-window snapshots (undercounts real usage)."
        )
    if "unknown" in all_kinds:
        notes.append("? = model has no known API price (e.g. Cursor composer-*, some Grok variants)")
    if "actual" in all_kinds:
        notes.append("unmarked = actual cost from logs (Claude Code)")
    if notes:
        print()
        for n in notes:
            print(f"  {n}")


def print_json(summaries: list[PeriodSummary], group_by: str) -> None:
    rows = []
    for s in summaries:
        rows.append(
            {
                "period": s.period,
                "source": s.source,
                "session_id": s.session_id or None,
                "workspace": s.workspace or None,
                "input_tokens": s.input_tokens,
                "output_tokens": s.output_tokens,
                "cache_create_tokens": s.cache_create_tokens,
                "cache_read_tokens": s.cache_read_tokens,
                "total_tokens": s.total_tokens,
                "cost_usd": round(s.cost_usd, 6),
                "cost_kinds": sorted(s.cost_kinds),
                "models": {
                    m: {
                        "input_tokens": mb["input"],
                        "output_tokens": mb["output"],
                        "cache_create_tokens": mb["cache_create"],
                        "cache_read_tokens": mb["cache_read"],
                        "cost_usd": round(mb["cost"], 6),
                    }
                    for m, mb in s.models.items()
                },
            }
        )
    totals = {
        "input_tokens": sum(s.input_tokens for s in summaries),
        "output_tokens": sum(s.output_tokens for s in summaries),
        "cache_create_tokens": sum(s.cache_create_tokens for s in summaries),
        "cache_read_tokens": sum(s.cache_read_tokens for s in summaries),
        "cost_usd": round(sum(s.cost_usd for s in summaries), 6),
    }
    print(json.dumps({"group_by": group_by, "rows": rows, "totals": totals}, indent=2))


# ── CLI ───────────────────────────────────────────────────────────────────────


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ai-costs",
        description="Token usage and cost estimates across AI coding agents.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            cost kinds:
              actual      Real USD from Claude Code logs (costUSD)
              calculated  Tokens × API price (Claude Code when costUSD missing)
              estimated   Counterfactual API cost for Cursor (subscription)
              unknown     No public price for this model (e.g. composer-*)

            examples:
              %(prog)s                              Daily report, all sources
              %(prog)s daily --source cursor        Cursor estimated API cost
              %(prog)s monthly -b                   Monthly with per-model breakdown
              %(prog)s session --source claude      Claude sessions
              %(prog)s daily --since 2026-07-01
              %(prog)s daily --default-model claude-sonnet-4-6
              %(prog)s daily --json --offline
        """),
    )
    parser.add_argument(
        "report",
        nargs="?",
        default="daily",
        choices=["daily", "monthly", "session"],
        help="Report type (default: daily)",
    )
    parser.add_argument(
        "-s", "--source",
        choices=["cursor", "claude", "devin"],
        help="Restrict to one AI tool (default: all available)",
    )
    parser.add_argument("-w", "--workspace", help="Filter by workspace path")
    parser.add_argument("--since", help="Start date YYYY-MM-DD")
    parser.add_argument("--until", help="End date YYYY-MM-DD (inclusive)")
    parser.add_argument(
        "-b", "--breakdown", action="store_true", help="Per-model breakdown"
    )
    parser.add_argument("-j", "--json", action="store_true", help="JSON output")
    parser.add_argument(
        "--offline", action="store_true", help="Use embedded pricing only"
    )
    parser.add_argument(
        "--default-model",
        help="Model to assume for Cursor conversations marked 'default'",
    )
    return parser


def main() -> None:
    args = build_parser().parse_args()
    backends = get_backends(args.source)

    pricing = PricingTable()
    if not args.offline:
        pricing.load_litellm()

    entries: list[UsageEntry] = []
    for b in backends:
        entries.extend(
            b.load_entries(
                workspace=args.workspace,
                default_model=args.default_model,
            )
        )

    entries = filter_entries(entries, since=args.since, until=args.until)
    entries = price_entries(entries, pricing)

    if not args.json:
        sources = ", ".join(b.name for b in backends)
        print(f"Sources: {sources}  |  Pricing: {pricing.source}")
        if args.default_model:
            print(f"Cursor 'default' model assumed as: {args.default_model}")
        print()

    summaries = aggregate(entries, group_by=args.report)

    if args.json:
        print_json(summaries, args.report)
    else:
        print_table(summaries, group_by=args.report, breakdown=args.breakdown)


if __name__ == "__main__":
    main()
