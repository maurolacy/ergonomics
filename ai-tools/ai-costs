# ── Data model ────────────────────────────────────────────────────────────────


@dataclass
class UsageEntry:
    source: str
    date: str  # YYYY-MM-DD
    model: str
    input_tokens: int = 0
    output_tokens: int = 0
    cache_create_tokens: int = 0
    cache_read_tokens: int = 0
    cost_usd: float | None = None  # None = not yet priced
    cost_kind: str = "calculated"  # "actual" | "estimated" | "calculated" | "unknown"
    session_id: str = ""
    workspace: str = ""

    @property
    def total_tokens(self) -> int:
        return (
            self.input_tokens
            + self.output_tokens
            + self.cache_create_tokens
            + self.cache_read_tokens
        )


@dataclass
class Pricing:
    input: float  # USD per token
    output: float
    cache_create: float = 0.0
    cache_read: float = 0.0


@dataclass
class PeriodSummary:
    period: str
    source: str
    input_tokens: int = 0
    output_tokens: int = 0
    cache_create_tokens: int = 0
    cache_read_tokens: int = 0
    cost_usd: float = 0.0
    models: dict[str, dict] = field(default_factory=dict)
    session_id: str = ""
    workspace: str = ""
    cost_kinds: set[str] = field(default_factory=set)

    @property
    def total_tokens(self) -> int:
        return (
            self.input_tokens
            + self.output_tokens
            + self.cache_create_tokens
            + self.cache_read_tokens
        )


