def cmd_forget(args: argparse.Namespace) -> None:
    """Remove entries by ID or clear ingestion log for re-processing."""
    conn = open_db(Path(args.db))

    if args.entry_id:
        conn.execute("DELETE FROM entries WHERE id = ?", (args.entry_id,))
        conn.commit()
        print(f"Deleted entry {args.entry_id}.")
    elif args.file:
        # Clear ingestion record so the file can be re-ingested
        fpath = Path(args.file)
        if fpath.exists():
            fh = file_hash(fpath)
            conn.execute("DELETE FROM ingestion_log WHERE file_hash = ?", (fh,))
            conn.commit()
            print(f"Cleared ingestion record for {fpath.name}. It will be re-processed on next ingest.")
        else:
            # Try matching by filename
            conn.execute("DELETE FROM ingestion_log WHERE filename = ?", (args.file,))
            conn.commit()
            print(f"Cleared ingestion record for {args.file}.")
    elif args.reset:
        count = conn.execute("SELECT COUNT(*) as n FROM entries").fetchone()["n"]
        conn.execute("DELETE FROM entries")
        conn.execute("DELETE FROM ingestion_log")
        conn.execute("DELETE FROM entries_fts")
        conn.commit()
        print(f"Reset complete. Removed {count} entries and all ingestion records.")
    else:
        print("Specify --id, --file, or --reset.")

    conn.close()


# ── CLI ───────────────────────────────────────────────────────────────────────

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ai-context",
        description="Persistent AI context memory — the bitácora",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--db", default=str(DEFAULT_DB),
        help=f"Database path (default: {DEFAULT_DB})",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # ingest
    p_ingest = sub.add_parser("ingest", help="Ingest conversation exports")
    p_ingest.add_argument("files", nargs="*", help="Markdown files or directories to ingest")
    p_ingest.add_argument("--auto", action="store_true",
                          help="Auto-export from ai-conversations, then ingest")
    p_ingest.add_argument("-w", "--workspace", help="Filter workspace (with --auto)")
    p_ingest.add_argument("-s", "--source", help="Filter source (with --auto): devin, cursor, claude, vscode")
    p_ingest.add_argument("--provider", choices=["anthropic", "openrouter"],
                          help="LLM provider")
    p_ingest.add_argument("--model", help="LLM model name")
    p_ingest.add_argument("--dry-run", action="store_true",
                          help="Show what would be ingested without calling LLM")

    # query
    p_query = sub.add_parser("query", help="Search the bitácora")
    p_query.add_argument("term", nargs="?", help="Search term (FTS5 syntax)")
    p_query.add_argument("--category", "-c", choices=CATEGORIES, help="Filter by category")
    p_query.add_argument("--project", "-p", help="Filter by project name")
    p_query.add_argument("--since", help="Show entries from this date (YYYY-MM-DD)")
    p_query.add_argument("--limit", "-n", type=int, help="Max results (default: 50)")

    # show
    p_show = sub.add_parser("show", help="Show entry details")
    p_show.add_argument("entry_id", type=int, help="Entry ID")

    # stats
    sub.add_parser("stats", help="Database statistics")

    # providers
    sub.add_parser("providers", help="Show available LLM providers")

    # forget
    p_forget = sub.add_parser("forget", help="Remove entries or reset ingestion")
    p_forget.add_argument("--id", dest="entry_id", type=int, help="Delete entry by ID")
    p_forget.add_argument("--file", help="Clear ingestion record for a file")
    p_forget.add_argument("--reset", action="store_true", help="Reset entire database")

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    cmd_map = {
        "ingest": cmd_ingest,
        "query": cmd_query,
        "show": cmd_show,
        "stats": cmd_stats,
        "providers": cmd_providers,
        "forget": cmd_forget,
    }
    cmd_map[args.command](args)


if __name__ == "__main__":
    main()
