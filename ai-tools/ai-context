#!/usr/bin/env python3
"""Persistent AI context memory — the bitácora.

Ingests exported AI conversations (from ai-conversations export), sends them
through an LLM for structured extraction, and stores the results in a local
SQLite database.  Entries are categorised as Decisions, Discoveries, State, or
Contacts, and are queryable by project, category, date, and free text.

The LLM step can use Anthropic (Claude) or OpenRouter (open-source models).
Set ANTHROPIC_API_KEY or OPENROUTER_API_KEY accordingly.

Usage examples:
    ai-context ingest exported/                   Ingest all markdown exports
    ai-context ingest exported/20261013_devin_*.md  Ingest specific files
    ai-context ingest --auto                      Export + ingest in one step
    ai-context ingest --auto -w ~/work/PSA        Auto-ingest for a workspace

    ai-context query "credstore"                  Full-text search
    ai-context query --category decision          Filter by category
    ai-context query --project cyber-psa          Filter by project
    ai-context query --since 2026-10-01           Date filter

    ai-context show 42                            Show entry details
    ai-context stats                              Summary of the database

    ai-context providers                          Show available LLM providers

Options:
    --provider anthropic|openrouter       LLM provider (default: auto-detect from keys)
    --model MODEL                         Model name (default: provider-specific)
    --db PATH                             Database path (default: ~/.local/share/ai-context/bitacora.db)
    --dry-run                             Show what would be ingested, don't call LLM
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sqlite3
import subprocess
import sys
